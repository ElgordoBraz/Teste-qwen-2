# ET NA SETE - Configuracao central do projeto (Godot 4.3)
[application]

config/name="ET NA SETE"
config/description="Acao e sobrevivencia contra hordas alienigenas no centro de Belo Horizonte."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
application/export_path="build/"

[autoload]

GameDB="*res://scripts/systems/GameDB.gd"
GameState="*res://scripts/managers/GameState.gd"
Audio="*res://scripts/systems/AudioManager.gd"
Effects="*res://scripts/effects/Effects.gd"
WaveManager="*res://scripts/waves/WaveManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

mouse/mouse_mode_visible=true

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.55, 0.36, 0.31, 1)

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="Interactables"
3d_physics/layer_5="Traps"
3d_physics/layer_6="Projectiles"

[input]

interact={
"deadzone": false,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"pressed":false,"code":69,"physical_code":0)]
}
